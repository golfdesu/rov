diff --git a/frontend/src/components/ScreenshotImportModal.tsx b/frontend/src/components/ScreenshotImportModal.tsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/components/ScreenshotImportModal.tsx
@@ -0,0 +1,349 @@
+import { Camera, CheckCircle2, Sparkles, Upload, X } from "lucide-react";
+import { type ChangeEvent, useEffect, useId, useMemo, useState } from "react";
+import { useLanguage } from "../i18n/language";
+import { CANONICAL_DRAFT_STEPS, type Hero, type RecordedDraftGame } from "../types/draft";
+import { formatRecordedTimestamp } from "../utils/draft";
+import { displayName } from "../utils/heroNames";
+import { Alert } from "./Alert";
+import { HeroPortrait } from "./HeroPortrait";
+import { Modal } from "./Modal";
+import { StableButtonLabel } from "./StableButtonLabel";
+
+interface ScreenshotImportModalProps {
+  heroes: Hero[];
+  heroMap: Map<string, Hero>;
+  isPaid: boolean;
+  onLoadImportedDraft: (game: RecordedDraftGame) => void;
+  onClose: () => void;
+}
+
+type SlotGroup = "blueBans" | "redBans" | "bluePicks" | "redPicks";
+
+interface ActiveSlot {
+  group: SlotGroup;
+  index: number;
+}
+
+const MAX_FILE_BYTES = 5 * 1024 * 1024;
+const ALLOWED_TYPES = new Set(["image/png", "image/jpeg", "image/webp"]);
+
+export function ScreenshotImportModal({
+  heroes,
+  heroMap,
+  isPaid,
+  onLoadImportedDraft,
+  onClose,
+}: ScreenshotImportModalProps) {
+  const { t } = useLanguage();
+  const titleId = useId();
+  const [previewUrl, setPreviewUrl] = useState<string | null>(null);
+  const [fileError, setFileError] = useState<string | null>(null);
+  const [blueTeamName, setBlueTeamName] = useState("TEAM A");
+  const [redTeamName, setRedTeamName] = useState("TEAM B");
+  const [blueBans, setBlueBans] = useState<(string | null)[]>([null, null, null, null]);
+  const [redBans, setRedBans] = useState<(string | null)[]>([null, null, null, null]);
+  const [bluePicks, setBluePicks] = useState<(string | null)[]>([null, null, null, null, null]);
+  const [redPicks, setRedPicks] = useState<(string | null)[]>([null, null, null, null, null]);
+  const [activeSlot, setActiveSlot] = useState<ActiveSlot | null>({ group: "blueBans", index: 0 });
+  const [search, setSearch] = useState("");
+
+  useEffect(() => {
+    return () => {
+      if (previewUrl) URL.revokeObjectURL(previewUrl);
+    };
+  }, [previewUrl]);
+
+  function handleFileChange(event: ChangeEvent<HTMLInputElement>) {
+    const file = event.target.files?.[0];
+    event.target.value = "";
+    setFileError(null);
+    if (!file) return;
+    if (!ALLOWED_TYPES.has(file.type)) {
+      setFileError("รองรับเฉพาะไฟล์ภาพ PNG, JPG หรือ WebP");
+      return;
+    }
+    if (file.size > MAX_FILE_BYTES) {
+      setFileError("ขนาดไฟล์ต้องไม่เกิน 5 MB");
+      return;
+    }
+    const nextUrl = URL.createObjectURL(file);
+    setPreviewUrl(nextUrl);
+  }
+
+  const usedHeroes = useMemo(
+    () => new Set([...blueBans, ...redBans, ...bluePicks, ...redPicks].filter((h): h is string => Boolean(h))),
+    [blueBans, redBans, bluePicks, redPicks],
+  );
+
+  function setSlotHero(group: SlotGroup, index: number, value: string | null) {
+    const update = (setter: React.Dispatch<React.SetStateAction<(string | null)[]>>) => {
+      setter((prev) => prev.map((v, i) => (i === index ? value : v)));
+    };
+    if (group === "blueBans") update(setBlueBans);
+    else if (group === "redBans") update(setRedBans);
+    else if (group === "bluePicks") update(setBluePicks);
+    else update(setRedPicks);
+  }
+
+  function assignHero(heroName: string) {
+    if (!activeSlot || usedHeroes.has(heroName)) return;
+    const { group, index } = activeSlot;
+    setSlotHero(group, index, heroName);
+
+    const maxIdx = group.endsWith("Bans") ? 3 : 4;
+    if (index < maxIdx) setActiveSlot({ group, index: index + 1 });
+  }
+
+  const filteredHeroes = useMemo(() => {
+    const q = search.trim().toLowerCase();
+    return heroes.filter(
+      (h) => !q || h.name.toLowerCase().includes(q) || displayName(h.name).toLowerCase().includes(q),
+    );
+  }, [heroes, search]);
+
+  const cleanBlueBans = blueBans.filter((h): h is string => Boolean(h));
+  const cleanRedBans = redBans.filter((h): h is string => Boolean(h));
+  const cleanBluePicks = bluePicks.filter((h): h is string => Boolean(h));
+  const cleanRedPicks = redPicks.filter((h): h is string => Boolean(h));
+  const filledTotal =
+    cleanBlueBans.length + cleanRedBans.length + cleanBluePicks.length + cleanRedPicks.length;
+  const hasAny = filledTotal > 0;
+
+  const prefixGapLabel = useMemo(() => {
+    if (!hasAny) return null;
+    const cursors = { blueBans: 0, redBans: 0, bluePicks: 0, redPicks: 0 };
+    const arrays = { blueBans, redBans, bluePicks, redPicks };
+    let contiguous = 0;
+    let firstMissing: string | null = null;
+    for (const step of CANONICAL_DRAFT_STEPS) {
+      const key: SlotGroup =
+        step.side === "blue"
+          ? step.action === "ban"
+            ? "blueBans"
+            : "bluePicks"
+          : step.action === "ban"
+            ? "redBans"
+            : "redPicks";
+      const val = arrays[key][cursors[key]];
+      if (!val) {
+        firstMissing = step.label ?? key;
+        break;
+      }
+      cursors[key] += 1;
+      contiguous += 1;
+    }
+    return contiguous === filledTotal ? null : (firstMissing ?? "Blue Ban 1");
+  }, [hasAny, filledTotal, blueBans, redBans, bluePicks, redPicks]);
+
+  function renderSlotRow(group: SlotGroup, label: string, items: (string | null)[], tone: "blue" | "red") {
+    const borderTone = tone === "blue" ? "border-blue/40" : "border-red/40";
+    return (
+      <div className="space-y-1">
+        <p className={`font-mono text-[10px] font-bold ${tone === "blue" ? "text-blue" : "text-red"}`}>{label}</p>
+        <div className="flex flex-wrap gap-1.5">
+          {items.map((heroName, idx) => {
+            const isSelected = activeSlot?.group === group && activeSlot.index === idx;
+            return (
+              <div key={`${group}-${idx}`} className="relative">
+                <button
+                  type="button"
+                  onClick={() => setActiveSlot({ group, index: idx })}
+                  className={`flex h-12 w-14 flex-col items-center justify-center border p-1 text-center transition-colors ${
+                    isSelected ? "border-gold bg-gold/15" : `${borderTone} bg-bg hover:border-line-strong`
+                  }`}
+                >
+                  {heroName ? (
+                    <>
+                      <div className="size-6 overflow-hidden border border-line">
+                        <HeroPortrait name={heroName} hero={heroMap.get(heroName)} />
+                      </div>
+                      <span className="w-full truncate text-[9px] text-ink">{displayName(heroName)}</span>
+                    </>
+                  ) : (
+                    <span className="font-mono text-[10px] text-dim">{idx + 1}</span>
+                  )}
+                </button>
+                {heroName && (
+                  <button
+                    type="button"
+                    aria-label={`${t("ล้างช่อง")} ${label} #${idx + 1}`}
+                    onClick={() => {
+                      setSlotHero(group, idx, null);
+                      setActiveSlot({ group, index: idx });
+                    }}
+                    className="absolute -top-1.5 -right-1.5 grid size-6 place-items-center border border-line-strong bg-panel text-dim hover:border-red hover:text-red"
+                  >
+                    <X className="size-3" />
+                  </button>
+                )}
+              </div>
+            );
+          })}
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <Modal labelledBy={titleId} className="max-w-4xl overflow-hidden" onClose={onClose}>
+      {(requestClose) => (
+        <>
+          <div className="flex shrink-0 items-center justify-between gap-2 border-b border-line px-4 py-3">
+            <div className="flex min-w-0 items-center gap-2">
+              <Camera className="h-4 w-4 shrink-0 text-gold" />
+              <h2 id={titleId} className="truncate font-display text-sm font-bold tracking-wider text-ink sm:text-base">
+                {t("นำเข้าดราฟต์จากภาพหน้าจอ")}
+              </h2>
+            </div>
+            <button
+              type="button"
+              onClick={() => requestClose()}
+              aria-label={t("ปิด")}
+              className="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded text-dim hover:bg-panel-2 hover:text-ink"
+            >
+              <X size={18} />
+            </button>
+          </div>
+
+          <div className="min-h-0 flex-1 space-y-4 overflow-y-auto p-4">
+            {!isPaid && (
+              <Alert tone="warning">
+                {t("สำหรับแพ็ก Pro, Duo และ Business")}{" "}
+                <a href="#plans" onClick={() => requestClose()} className="font-bold underline">
+                  {t("ดูแพ็ก")}
+                </a>
+              </Alert>
+            )}
+
+            <div className="grid gap-4 md:grid-cols-[1fr_1.2fr]">
+              {/* Upload & preview */}
+              <div className="space-y-3">
+                <label className="flex cursor-pointer flex-col items-center justify-center gap-2 border border-dashed border-gold/50 bg-bg/60 p-4 text-center hover:bg-panel-2">
+                  <Upload className="size-6 text-gold" />
+                  <span className="text-xs font-semibold text-ink">{t("เลือกภาพหน้าจอดราฟต์ในเกม RoV")}</span>
+                  <span className="text-[11px] text-dim">PNG / JPG / WebP · ≤ 5 MB</span>
+                  <input
+                    type="file"
+                    accept="image/png,image/jpeg,image/webp"
+                    className="sr-only"
+                    onChange={handleFileChange}
+                  />
+                </label>
+                {fileError && <Alert>{t(fileError)}</Alert>}
+                {previewUrl && (
+                  <div className="space-y-2 border border-line bg-bg p-2">
+                    <img src={previewUrl} alt={t("ภาพหน้าจอดราฟต์ที่เลือก")} className="max-h-52 w-full object-contain" />
+                    <p className="flex items-center gap-1.5 text-[11px] text-gold">
+                      <Sparkles className="size-3.5 shrink-0" />
+                      <span>{t("ดูภาพเทียบแล้วเลือกฮีโร่ลงช่องด้านขวาตามลำดับดราฟต์")}</span>
+                    </p>
+                  </div>
+                )}
+              </div>
+
+              {/* 18-slot review board */}
+              <div className="space-y-3 border border-line bg-panel-2/40 p-3">
+                <div className="grid grid-cols-2 gap-2">
+                  <input
+                    type="text"
+                    maxLength={14}
+                    value={blueTeamName}
+                    onChange={(e) => setBlueTeamName(e.target.value.toUpperCase())}
+                    aria-label="Blue team"
+                    className="min-h-8 border border-blue/40 bg-bg px-2 font-display text-xs font-bold text-blue"
+                  />
+                  <input
+                    type="text"
+                    maxLength={14}
+                    value={redTeamName}
+                    onChange={(e) => setRedTeamName(e.target.value.toUpperCase())}
+                    aria-label="Red team"
+                    className="min-h-8 border border-red/40 bg-bg px-2 font-display text-xs font-bold text-red"
+                  />
+                </div>
+
+                {renderSlotRow("blueBans", "BLUE BANS (4)", blueBans, "blue")}
+                {renderSlotRow("redBans", "RED BANS (4)", redBans, "red")}
+                {renderSlotRow("bluePicks", "BLUE PICKS (5)", bluePicks, "blue")}
+                {renderSlotRow("redPicks", "RED PICKS (5)", redPicks, "red")}
+
+                <div className="space-y-2 border-t border-line pt-2">
+                  <input
+                    type="text"
+                    value={search}
+                    onChange={(e) => setSearch(e.target.value)}
+                    placeholder={t("ค้นหาฮีโร่เพื่อใส่ในช่องที่เลือก…")}
+                    className="min-h-8 w-full border border-line bg-bg px-2.5 text-xs text-ink"
+                  />
+                  <div className="grid max-h-36 grid-cols-6 gap-1 overflow-y-auto">
+                    {filteredHeroes.map((hero) => {
+                      const alreadyUsed = usedHeroes.has(hero.name);
+                      return (
+                        <button
+                          key={hero.name}
+                          type="button"
+                          disabled={alreadyUsed}
+                          title={alreadyUsed ? `${displayName(hero.name)} (${t("ใช้ไปแล้ว")})` : displayName(hero.name)}
+                          onClick={() => assignHero(hero.name)}
+                          className={`flex flex-col items-center gap-0.5 border p-1 transition-colors ${
+                            alreadyUsed
+                              ? "cursor-not-allowed border-line/50 bg-bg/40 opacity-35 grayscale"
+                              : "border-line bg-bg hover:border-gold"
+                          }`}
+                        >
+                          <div className="size-7 overflow-hidden">
+                            <HeroPortrait name={hero.name} hero={heroMap.get(hero.name)} />
+                          </div>
+                          <span className="w-full truncate text-[9px] text-ink">{displayName(hero.name)}</span>
+                        </button>
+                      );
+                    })}
+                  </div>
+                </div>
+                {prefixGapLabel && (
+                  <Alert tone="warning">
+                    {t("เลือกฮีโร่ตามลำดับเทิร์นให้ครบก่อน (ขาดช่อง {0})", prefixGapLabel)}
+                  </Alert>
+                )}
+              </div>
+            </div>
+          </div>
+
+          <div className="flex shrink-0 items-center justify-end gap-2 border-t border-line bg-bg px-4 py-3">
+            <button
+              type="button"
+              onClick={() => requestClose()}
+              className="min-h-9 border border-line-strong px-4 text-xs font-semibold text-muted hover:text-ink"
+            >
+              <StableButtonLabel message="ยกเลิก" />
+            </button>
+            <button
+              type="button"
+              disabled={!hasAny || prefixGapLabel !== null}
+              onClick={() => {
+                onLoadImportedDraft({
+                  id: `import-${Date.now()}`,
+                  gameNumber: 1,
+                  timestamp: formatRecordedTimestamp(),
+                  blueTeamName: blueTeamName.trim() || "TEAM A",
+                  redTeamName: redTeamName.trim() || "TEAM B",
+                  blueSideTeam: "A",
+                  blueBans: cleanBlueBans,
+                  redBans: cleanRedBans,
+                  bluePicks: cleanBluePicks,
+                  redPicks: cleanRedPicks,
+                  blueWinRate: 50,
+                });
+                requestClose();
+              }}
+              className="inline-flex min-h-9 items-center gap-1.5 border border-gold bg-gold px-4 font-display text-xs font-bold text-bg hover:bg-gold/90 disabled:opacity-40"
+            >
+              <CheckCircle2 className="size-4" />
+              <StableButtonLabel message="โหลดขึ้นกระดานดราฟต์" />
+            </button>
+          </div>
+        </>
+      )}
+    </Modal>
+  );
+}
