+def test_ranked_10_ban_mode_api_and_validation():
+    ten_bans_blue = ["Rouie", "Billow", "Dolia", "Toro", "Aoi"]
+    ten_bans_red = ["TeeMee", "Marja", "Heino", "Goverra", "Keera"]
+
+    # 1. Tournament mode still rejects >4 bans per side
+    bad_tourney = client.post(
+        "/predict",
+        json={
+            "draft_mode": "tournament",
+            "mode": "pick",
+            "side": "blue",
+            "phase": 1,
+            "ally_bans": ten_bans_blue,
+            "enemy_bans": ten_bans_red,
+        },
+    )
+    assert bad_tourney.status_code == 422
+
+    # 2. Ranked mode accepts 5+5=10 upfront bans and runs pick phase + lookahead cleanly
+    ranked_pick = client.post(
+        "/predict",
+        json={
+            "draft_mode": "ranked",
+            "mode": "pick",
+            "side": "blue",
+            "phase": 1,
+            "ally_picks": [],
+            "enemy_picks": [],
+            "ally_bans": ten_bans_blue,
+            "enemy_bans": ten_bans_red,
+            "top_k": 5,
+            "use_lookahead": True,
+            "lookahead_depth": 2,
+        },
+    )
+    assert ranked_pick.status_code == 200
+    data = ranked_pick.json()
+    assert len(data["recommendations"]) == 5
+    banned_set = set(ten_bans_blue + ten_bans_red)
+    for rec in data["recommendations"]:
+        assert rec["hero_name"] not in banned_set
+        assert rec["lookahead_win_rate_pct"] is not None
+    assert data["blue_next_bans"] == []
+    assert data["red_next_bans"] == []
+
+    # 3. Completed 5v5 ranked board (10 bans + 10 picks) evaluates cleanly
+    ranked_done = client.post(
+        "/predict",
+        json={
+            "draft_mode": "ranked",
+            "mode": "pick",
+            "side": "blue",
+            "phase": 2,
+            "ally_picks": ["Yena", "Nakroth", "Liliana", "Hayate", "Thane"],
+            "enemy_picks": ["Florentino", "Murad", "Krixi", "Capheny", "Lumburr"],
+            "ally_bans": ten_bans_blue,
+            "enemy_bans": ten_bans_red,
+            "top_k": 1,
+        },
+    )
+    assert ranked_done.status_code == 200
+    assert 0.0 <= ranked_done.json()["recommendations"][0]["predicted_win_rate_pct"] <= 100.0
