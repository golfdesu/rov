+                                    if (raw === undefined) return;
+                                    const parsed = Math.round(Number(raw));
+                                    if (Number.isFinite(parsed) && raw.trim() !== "") {
+                                      const clamped = Math.max(0, Math.min(maxLv, parsed));
+                                      if (clamped !== s.skill_level) setNum("skill_levels", levelKey, clamped);
