+              </div>
+
+              {/* Category Pills */}
+              <div className="mb-2 flex flex-wrap gap-1">
+                {categories.map((c) => (
+                  <button
+                    type="button"
+                    key={c}
+                    onClick={() => {
+                      setSelectedCategory(c);
+                    }}
+                    className={`min-h-6 min-w-6 rounded px-1.5 py-0.5 text-[10px] font-semibold transition-colors ${
+                      selectedCategory === c
