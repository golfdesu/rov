new file mode 100644
--- /dev/null
+++ b/frontend/src/components/lab/EnchantmentSocket.tsx
@@ -0,0 +1,79 @@
+import { useLanguage } from "../../i18n/language";
+import { X } from "lucide-react";
+import { useState } from "react";
+import type { CatalogEnchantment } from "../../types/combat";
+import { ROMAN } from "./enchantmentFactions";
+
+/** One enchantment slot: empty tier placeholder, or the chosen icon with a hover clear button. */
+export function SocketItem({
+  tier,
+  name,
+  ench,
+  isMajor,
+  factionColor,
+  onClear,
+}: {
+  tier: number;
+  name?: string;
+  ench?: CatalogEnchantment;
+  isMajor: boolean;
+  factionColor?: string;
+  onClear: () => void;
+}) {
+  const { t } = useLanguage();
+  const sizeClass = isMajor ? "h-14 w-14" : "h-11 w-11";
+  const [failedSrc, setFailedSrc] = useState<string | null>(null);
+
+  if (!ench || !name) {
+    return (
+      <div className="flex flex-col items-center">
+        <div
+          className={`flex ${sizeClass} items-center justify-center rounded-full border-2 border-dashed border-line bg-panel text-[11px] font-mono text-dim`}
+        >
+          {ROMAN[tier]}
+        </div>
+        <span className="mt-1 text-[9px] text-dim">{t("ขั้น")} {tier}</span>
+      </div>
+    );
+  }
+
+  return (
+    <div className="group relative flex flex-col items-center">
+      <div
+        className={`relative ${sizeClass} rounded-full ring-2 ${
+          factionColor || (isMajor ? "ring-gold shadow-md shadow-gold/20" : "ring-line-strong")
+        }`}
+      >
+        {ench.icon_url && failedSrc !== ench.icon_url ? (
+          <img
+            key={ench.icon_url}
+            src={ench.icon_url}
+            alt={name}
+            className="h-full w-full rounded-full object-contain"
+            loading="lazy"
+            onError={() => setFailedSrc(ench.icon_url ?? null)}
+          />
+        ) : (
+          <div className="grid h-full w-full place-items-center rounded-full bg-panel font-mono text-[10px] font-bold text-gold">
+            {ROMAN[tier]}
+          </div>
+        )}
+        <button
+          type="button"
+          onClick={(e) => {
+            e.stopPropagation();
+            onClear();
+          }}
+          className="absolute -right-1.5 -top-1.5 grid h-6 w-6 place-items-center rounded-full bg-red text-bg shadow opacity-100 transition-opacity focus-visible:opacity-100 sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100"
+          title={t("ลบ {0}", name)}
+          aria-label={t("ลบ {0}", name)}
+        >
+          <X size={11} />
+        </button>
+      </div>
+      <span className="mt-1 max-w-[65px] truncate text-center text-[10px] font-medium text-ink">
+        {ench.category || name}
+      </span>
+    </div>
+  );
+}
