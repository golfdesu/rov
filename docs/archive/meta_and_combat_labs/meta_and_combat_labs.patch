+            onPick={(n) => setItem(picking, n)}
+            onInspect={(name) => setInspectingItem(name)}
+            onClose={() => setPicking(null)}
+          />
+        )}
+      </Section>
+
+      {/* Item Card Screenshot Modal */}
+      {inspectingItem && (
+        <ItemCardModal
+          itemName={inspectingItem}
+          catalogItems={catalog.items}
+          onClose={() => setInspectingItem(null)}
+          onPick={
+            picking !== null || build.items.length < 6
+              ? (picked) => {
+                  if (picking !== null) {
+                    setItem(picking, picked);
+                  } else if (build.items.length < 6) {
+                    setItem(build.items.length, picked);
+                  }
+                }
+              : undefined
+          }
+        />
+      )}
+
+      {/* Arcana Board */}
+      <Section title={t("รูน Tier 3")}>
+        <ArcanaBoard
+          arcana={catalog.arcana}
+          chosen={build.arcana}
+          maxPerColor={catalog.arcana_slots_per_color}
+          onChange={(arcana) => onChange({ arcana })}
+        />
+      </Section>
+
+      {/* Enchantment Board */}
+      <Section title={t("พลังแฝง")}>
+        <EnchantmentBoard
+          catalog={catalog}
+          primaryFaction={build.primary_faction}
+          primaryEnchantments={build.primary_enchantments}
+          secondaryFaction={build.secondary_faction}
+          secondaryEnchantments={build.secondary_enchantments}
+          onChange={(patch) => onChange(patch)}
+        />
+      </Section>
+    </div>
+  );
+}
