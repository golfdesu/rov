+                    <button
+                      type="button"
+                      aria-label={t("ดูการ์ด {0}", item.name)}
+                      title={item.name}
+                      onClick={(e) => {
+                        e.stopPropagation();
+                        setInspectingItem(item.name);
+                      }}
+                      className="absolute -left-1.5 -bottom-1.5 grid h-6 w-6 place-items-center rounded-xs bg-gold/90 text-bg shadow hover:bg-gold"
+                    >
+                      <Info size={11} />
+                    </button>
+                  </>
+                )}
+              </div>
