+            </div>
+
+            {/* Catalog Quick Browse */}
+            <div className="border-t border-line pt-3">
+              <div className="mb-2 flex items-center justify-between">
+                <h4 className="flex items-center gap-1 text-[11px] font-semibold text-muted">
