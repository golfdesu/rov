+
+    const nextVal = Math.max(0, Math.min(cur + delta, cur + availableInColor));
+    const next = { ...chosen, [name]: nextVal };
+    if (!nextVal) delete next[name];
+    onChange(next);
+  };
+
+  const handleFillTen = (name: string, color: ArcanaColor) => {
